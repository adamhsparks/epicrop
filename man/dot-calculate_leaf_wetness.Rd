wth_wet <- wth[RAIN >= 2]
wet_dry <- .calculate_leaf_wetness(wth_dry, rhlim = 90, rainlim = 5)
wet_rain <- .calculate_leaf_wetness(wth_wet, rhlim = 90, rainlim = 5)
mean(wet_dry, na.rm = TRUE)  # Without rain
